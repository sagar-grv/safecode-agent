# Optional locally. Vercel deployments can use project OIDC automatically.
AI_GATEWAY_API_KEY=

# on: always try AI Gateway; off: deterministic planner; unset: auto-detect.
SAFECODE_AI_MODE=

# Current default is verified against the Vercel AI Gateway model catalog.
AI_MODEL=openai/gpt-5.4-mini

NEXT_PUBLIC_APP_URL=http://localhost:3000
